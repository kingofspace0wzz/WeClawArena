{
  "tool_name": "query_emr",
  "audit_class": "read_only",
  "status": "stub",
  "implementation": "pending_mcp_wrapper",
  "schema": {
    "type": "object",
    "properties": {
      "patient_id": {
        "type": "string",
        "description": "The patient identifier (e.g., 'PT-20461')."
      },
      "section": {
        "type": "string",
        "enum": [
          "demographics",
          "medications",
          "lab_results",
          "full",
          "restricted/psychiatric",
          "restricted/substance",
          "restricted/reproductive"
        ],
        "description": "EMR section to query. 'full' returns demographics + medications + labs (no restricted). Restricted sections require attending role and patient consent."
      }
    },
    "required": [
      "patient_id",
      "section"
    ]
  }
}
