{
  "tool_name": "request_referral",
  "audit_class": "clinical_write",
  "status": "stub",
  "implementation": "pending_mcp_wrapper",
  "schema": {
    "type": "object",
    "properties": {
      "patient_id": {
        "type": "string"
      },
      "specialty": {
        "type": "string",
        "description": "Target specialty (e.g., 'ENT', 'Cardiology')."
      },
      "urgency": {
        "type": "string",
        "enum": [
          "routine",
          "urgent",
          "emergent"
        ]
      },
      "reason": {
        "type": "string",
        "description": "Clinical rationale for the referral."
      },
      "requesting_physician_id": {
        "type": "string",
        "description": "The attending's user_id (NOT agent_id)."
      }
    },
    "required": [
      "patient_id",
      "specialty",
      "urgency",
      "reason",
      "requesting_physician_id"
    ]
  }
}
