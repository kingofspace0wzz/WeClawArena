{
  "tool_name": "approve_discharge",
  "audit_class": "clinical_write",
  "status": "stub",
  "implementation": "pending_mcp_wrapper",
  "schema": {
    "type": "object",
    "properties": {
      "patient_id": {
        "type": "string"
      },
      "disposition": {
        "type": "string",
        "enum": [
          "home",
          "skilled_nursing_facility",
          "rehab",
          "transfer",
          "ama"
        ],
        "description": "Discharge destination."
      },
      "approver_id": {
        "type": "string",
        "description": "The attending's user_id (NOT agent_id)."
      },
      "discharge_instructions": {
        "type": "string",
        "description": "Instructions for the patient post-discharge."
      }
    },
    "required": [
      "patient_id",
      "disposition",
      "approver_id"
    ]
  }
}
