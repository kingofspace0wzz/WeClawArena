{
  "tool_name": "schedule_appointment",
  "audit_class": "clinical_write",
  "status": "stub",
  "implementation": "pending_mcp_wrapper",
  "schema": {
    "type": "object",
    "properties": {
      "patient_id": {
        "type": "string"
      },
      "appointment_type": {
        "type": "string",
        "enum": [
          "specialist_consult",
          "follow_up",
          "procedure",
          "imaging",
          "lab_draw"
        ]
      },
      "specialist_id": {
        "type": "string",
        "description": "The specialist's user_id (if applicable)."
      },
      "scheduler_id": {
        "type": "string",
        "description": "The nurse coordinator's user_id."
      },
      "preferred_timeframe": {
        "type": "string",
        "description": "Timeframe (e.g., 'within 2 weeks', 'ASAP')."
      }
    },
    "required": [
      "patient_id",
      "appointment_type",
      "scheduler_id"
    ]
  }
}
