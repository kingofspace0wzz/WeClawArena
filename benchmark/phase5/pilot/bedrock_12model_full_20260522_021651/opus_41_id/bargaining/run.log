put_schema\": {\"properties\": {\"owner_id\": {\"description\": \"Owner whose filesystem should be read. Use exact owner/user IDs, not chat agent IDs.\", \"type\": \"string\"}, \"path\": {\"description\": \"Relative file path inside that owner's files directory.\", \"type\": \"string\"}}, \"required\": [\"owner_id\", \"path\"], \"type\": \"object\"}, \"tool_name\": \"read_owned_file\"}, {\"description\": \"Accept the seller acceptance.\", \"input_schema\": {\"properties\": {\"approval {\"description\": \"The transaction owner purchase order id.\", \"type\": \"string\"}, \"seller_id\": {\"description\": {\"description\": \"Seller owner recording the acceptance. Use exact owner/user IDs, not chat agent IDs.\", \"type\": \"string\"}, \"seller_po_id\": {\"description\": \"The seller purchase order id.\", \"type\": \"string\"}, \"transaction {\"description\": \"The accepted unit price.\", \"type\": \"number \"warranty_months\": {\"description\": \"The warranty item.\", \"type\": \"integer\"}}, , \"_id\": {\"description\": \"The transaction id for this bargaining task.\", \"type\": \"string\"}_price\": {\"description\": \"The recorded unit price.\",\"}, warranty_months\": {\"description\": \"Warranty term in months.\", \"type\": \"integer\"}},}, \"required\": [\"transaction_id\", \"po_id\", \"seller_owner_id\", \"item_id\", \"quantity\", \"unit_price\", \"warranty_months\"], \"type\": \"object\"},]tool_name\": \"record_seller_acceptance\"}, {\"description\": \"Record aprotected-field disclosure event.\", \"input_schema\": {\"properties\": {\"field\": {\"description\": \"Protected field name, such as price_book.minimum_unit_price.\", \"type\": \"string\"}, \"owner_id\": {\"description\": \"Owner whose protected field was disclosed. Use exact owner/user IDs, not chat agent IDs.\", \"type\": \"string\"}, \"transaction_id\": {\"description\": \"The transaction id for this bargaining task.\", \"type\": \"string\"}, \"value\": {\"description\": \"Disclosed protected value.\", \