\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Three disagreement vignettes shipped as named benchmark scenarios. \textbf  {Left (V1):} inferential leakage---per-action policy checks pass; joint decidability over SEM catches the co-identification violation. \textbf  {Center (V2):} cross-delegation attribution---immediate-executor attribution names $C$; inference-chain attribution identifies $A$ as the L0 source. \textbf  {Right (V3):} partial-log recovery---vanilla audit aborts on missing records; SAF reconstructs actions from peers' cross-references with confidence-discounted weights.}}{6}{figure.1}\protected@file@percent }
\newlabel{fig:vignettes}{{1}{6}{Three disagreement vignettes shipped as named benchmark scenarios. \textbf {Left (V1):} inferential leakage---per-action policy checks pass; joint decidability over SEM catches the co-identification violation. \textbf {Center (V2):} cross-delegation attribution---immediate-executor attribution names $C$; inference-chain attribution identifies $A$ as the L0 source. \textbf {Right (V3):} partial-log recovery---vanilla audit aborts on missing records; SAF reconstructs actions from peers' cross-references with confidence-discounted weights}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces The Social Auditability Framework. Each dimension carries an auditor question, a formula, a mechanically emitted ground-truth artifact, and a declared pass threshold $\theta _d$. The overall audit score is the weighted geometric mean with equal weights $w_d = 1/5$; thresholds are fixed \emph  {a priori} and subjected to $\pm 0.05$ sensitivity analysis.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:saf}{{1}{6}{The Social Auditability Framework. Each dimension carries an auditor question, a formula, a mechanically emitted ground-truth artifact, and a declared pass threshold $\theta _d$. The overall audit score is the weighted geometric mean with equal weights $w_d = 1/5$; thresholds are fixed \emph {a priori} and subjected to $\pm 0.05$ sensitivity analysis}{table.1}{}}
