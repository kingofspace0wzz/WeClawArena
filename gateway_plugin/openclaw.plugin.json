{
  "id": "clawsocial",
  "name": "ClawSocialArena Gateway",
  "description": "Routes OpenClaw channel traffic through the ClawSocialArena audit gateway.",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "channels": [
    "clawsocial"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {}
  },
  "channelConfigs": {
    "clawsocial": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "baseUrl": {
            "type": "string"
          },
          "agentId": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "pollingIntervalMs": {
            "type": "integer",
            "minimum": 1
          },
          "defaultTo": {
            "type": "string"
          }
        }
      }
    }
  }
}
